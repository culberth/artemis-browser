<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>com.culberth.tools</groupId>
    <artifactId>artemis-browser</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <name>${project.artifactId}</name>
    <description>Read-only web browser for ActiveMQ Artemis queues</description>
    <packaging>jar</packaging>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.release>21</maven.compiler.release>
        <!--
          0.8.12 (the version the sibling projects pin) cannot instrument Java 26 class files:
          the build fails with "Unsupported class file major version 70" from inside the agent.
          The JDK on PATH here is 26 even though we target release 21, so the agent sees 26.
        -->
        <jacoco.version>0.8.15</jacoco.version>
		<java-formatter-maven-plugin.version>1.0.1</java-formatter-maven-plugin.version>
        <!--
          The supported broker versions, and the integration matrix: every *IT runs once against each.
          Pinned, never "latest": which broker a test ran against must be knowable from the build.
          "deployed" is what the cluster runs (charts and the jms/claude-app namespaces); "newest" is
          the newest release checked. 2.44.0 measurements in .claude/memory.md are historical.
          Skip one with -Dit.newest.skip=true (or it.deployed.skip) for a quicker run.
        -->
        <artemis.image.deployed>apache/artemis:2.55.0-alpine</artemis.image.deployed>
        <artemis.image.newest>apache/artemis:2.57.0-alpine</artemis.image.newest>
        <it.deployed.skip>false</it.deployed.skip>
        <it.newest.skip>false</it.newest.skip>
    </properties>

    <dependencies>
        <!--
          Spring Boot 4 renamed the MVC starter: spring-boot-starter-web still resolves, but
          spring-boot-starter-webmvc is the current name and the one cached locally at 4.1.1.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>

        <!--
          Three things are easy to get wrong here, all of them silent:

          1. artemis-jakarta-client, NOT artemis-jms-client. The latter targets the old javax.jms
             namespace; Spring Boot 4 is jakarta.* throughout, and mixing them fails at runtime with
             NoClassDefFoundError on jakarta/jms/Connection rather than at compile time.
          2. groupId org.apache.artemis, NOT org.apache.activemq. Artemis moved groupId; Boot 4.1.1
             manages the client under the new one (2.53.0 at time of writing).
          3. No <version> and no artemis.version property of our own. spring-boot-dependencies
             defines a property by exactly that name and imports org.apache.artemis:artemis-bom with
             it, so declaring one here silently redirects the BOM import to a coordinate that does
             not exist and the build fails while resolving the parent, before it ever reads this
             dependency.
        -->
        <dependency>
            <groupId>org.apache.artemis</groupId>
            <artifactId>artemis-jakarta-client</artifactId>
        </dependency>

        <!--
          The app has a login of its own as of Phase 7, because it is allowed to be reached from
          somewhere other than localhost. Everything it protects is read-only, but a broker
          connection is still an authenticated one, and handing that to whoever can reach the port
          is not a thing to do by default.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
          Spring Boot 4 moved the @WebMvcTest slice out of spring-boot-test-autoconfigure into its
          own artifact. Without this, @WebMvcTest simply does not resolve and the only symptom is
          "package org.springframework.boot.test.autoconfigure.web.servlet does not exist".
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
          Integration tests only (the "integration" profile). These start a real Artemis in Docker,
          because the request/reply plumbing and the non-destructive guarantee are the two things a
          mock cannot honestly check: a mock replies however it is told to, and a mock cannot be
          consumed from by accident. Version is managed by spring-boot-dependencies (2.0.5).

          Core artifact only: the container lifecycle is driven from @BeforeAll rather than the
          @Testcontainers extension, so the separate junit-jupiter module — which Boot's BOM does
          not manage — is not needed.
        -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <version>${jacoco.version}</version>
                <executions>
                    <execution>
                        <goals><goal>prepare-agent</goal></goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>test</phase>
                        <goals><goal>report</goal></goals>
                    </execution>
                </executions>
            </plugin>
			<plugin>
                <groupId>io.github.culberth</groupId>
                <artifactId>java-formatter-maven-plugin</artifactId>
                <version>${java-formatter-maven-plugin.version}</version>
                <executions>
					<execution>
						  <id>format-sources</id>
						  <goals>
								<goal>format</goal>
						  </goals>
					</execution>
                </executions>
			</plugin>
        </plugins>
    </build>

    <!--
      Integration tests are named *IT and run only here, so `mvn clean install` stays a build that
      needs nothing but Maven: `mvn verify -Pintegration` is the one command that starts a real
      broker in Docker and checks the things a mock cannot. Surefire ignores *IT by default, so no
      exclusion is needed on the normal path.
    -->
    <profiles>
        <profile>
            <id>integration</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-failsafe-plugin</artifactId>
                        <executions>
                            <!--
                              One execution per supported broker version, each in its own JVM with its own
                              container (the fixture keeps one per JVM) and its own reports directory, so a
                              failure names the version it failed on. Failsafe merges into an existing
                              summary, so run the matrix after a clean: a stale failure otherwise fails verify.
                            -->
                            <execution>
                                <!--
                                  spring-boot-starter-parent binds one unnamed ("default") execution of its own;
                                  left bound, every IT would run a third time against the fixture's default image.
                                -->
                                <id>default</id>
                                <phase>none</phase>
                            </execution>
                            <execution>
                                <id>broker-deployed</id>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                                <configuration>
                                    <skip>${it.deployed.skip}</skip>
                                    <reportsDirectory>${project.build.directory}/failsafe-reports/deployed</reportsDirectory>
                                    <summaryFile>${project.build.directory}/failsafe-reports/deployed/failsafe-summary.xml</summaryFile>
                                    <systemPropertyVariables>
                                        <artemis.image>${artemis.image.deployed}</artemis.image>
                                    </systemPropertyVariables>
                                </configuration>
                            </execution>
                            <execution>
                                <id>broker-newest</id>
                                <goals>
                                    <goal>integration-test</goal>
                                    <goal>verify</goal>
                                </goals>
                                <configuration>
                                    <skip>${it.newest.skip}</skip>
                                    <reportsDirectory>${project.build.directory}/failsafe-reports/newest</reportsDirectory>
                                    <summaryFile>${project.build.directory}/failsafe-reports/newest/failsafe-summary.xml</summaryFile>
                                    <systemPropertyVariables>
                                        <artemis.image>${artemis.image.newest}</artemis.image>
                                    </systemPropertyVariables>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
