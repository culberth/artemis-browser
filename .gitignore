# Maven build output
target/

# Claude Code. The memory file is committed on purpose — it is what shares project
# knowledge across Claude Code, Desktop and Web. Only machine-local settings are ignored.
.claude/settings.local.json

# Frontend. Which frontend this project uses is still undecided; these cost nothing
# until an npm-based one lands, and prevent a very large accident if it does.
node_modules/

